#!/usr/bin/env bash
# Runs factory.py with whichever Python 3 works here (python3 on macOS / Linux, python on Windows,
# where "python3" may be the Microsoft Store stub that only prints an error).
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
for py in python3 python py; do
  if command -v "$py" >/dev/null 2>&1 && "$py" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' >/dev/null 2>&1; then
    exec "$py" "$here/factory.py" "$@"
  fi
done
echo "factory: no Python 3.9+ found (tried python3, python, py)" >&2
exit 127
